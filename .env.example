# ==================== PostgreSQL ====================
# Used by the FastAPI backend. Works out of the box with docker-compose (service: db)
# Format: postgresql+psycopg2://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql+psycopg2://careerscope:careerscope@localhost:5432/careerscope
# Quick-start fallback: set to true to use a local SQLite file instead of PostgreSQL.
# Keep as false for the production/docker setup.
USE_SQLITE=false

# ==================== Secrets ====================
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
JWT_SECRET_KEY=

# ==================== External APIs ====================
# Get from https://console.groq.com
GROQ_API_KEY=
# Model used for analysis (change safely - it feeds a clean service layer)
GROQ_MODEL=openai/gpt-oss-120b
# Get from https://serpapi.com
SERPAPI_API_KEY=

# ==================== URLs ====================
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# ==================== Frontend (Vite) ====================
# API base URL for the built frontend. When set, the frontend calls
# <VITE_API_BASE_URL>/api/... (cross-origin). When empty, it uses the
# same-origin relative '/api' (dev proxy / single-service deployments).
VITE_API_BASE_URL=http://localhost:8000

# ==================== Optional email configuration ====================
# Only required for password-reset / verification emails.
# If not configured, reset tokens are returned in the dev API response
# (development mode) and logged on the server.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ==================== Runtime ====================
ENV=development
DEBUG=true
MAX_UPLOAD_SIZE_MB=10
AUTO_CREATE_TABLES=true